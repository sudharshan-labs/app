{
  "title": "NEXUS AI/ML Learning Roadmap",
  "description": "12-week beginner-to-portfolio roadmap for an aspiring AI/ML Engineer.",
  "weeks": [
    {
      "week": 1,
      "title": "Python Programming",
      "goal": "Build programming foundations and write small Python programs.",
      "topics": [
        "Python syntax, variables and data types",
        "Operators and conditional statements",
        "Loops and functions",
        "Lists, tuples, sets and dictionaries",
        "Strings, files and exception handling",
        "Modules, packages and virtual environments",
        "Practice problems and a mini project"
      ],
      "resources": [
        {
          "label": "W3Schools Python",
          "url": "https://www.w3schools.com/python/"
        }
      ]
    },
    {
      "week": 2,
      "title": "Mathematics for Machine Learning",
      "goal": "Understand the maths used in common ML algorithms.",
      "topics": [
        "Linear algebra: vectors and matrices",
        "Matrix operations and dot products",
        "Statistics: mean, median, variance and standard deviation",
        "Probability fundamentals and conditional probability",
        "Distributions and sampling",
        "Derivatives and gradients",
        "Maths practice using Python"
      ],
      "resources": [
        {
          "label": "GeeksforGeeks ML Mathematics",
          "url": "https://www.geeksforgeeks.org/machine-learning/machine-learning-mathematics/"
        }
      ]
    },
    {
      "week": 3,
      "title": "Artificial Intelligence Fundamentals",
      "goal": "Understand AI concepts, search, reasoning and intelligent systems.",
      "topics": [
        "What is AI, ML and deep learning?",
        "Types of AI and real-world applications",
        "Agents and environments",
        "Problem solving and search algorithms",
        "Knowledge representation and reasoning",
        "Ethics, bias and responsible AI",
        "AI fundamentals revision"
      ],
      "resources": [
        {
          "label": "GeeksforGeeks AI",
          "url": "https://www.geeksforgeeks.org/artificial-intelligence/artificial-intelligence/"
        }
      ]
    },
    {
      "week": 4,
      "title": "Machine Learning Fundamentals",
      "goal": "Learn the ML workflow and foundational supervised and unsupervised learning.",
      "topics": [
        "ML workflow and problem framing",
        "Supervised vs unsupervised learning",
        "Linear regression",
        "Logistic regression",
        "K-nearest neighbours",
        "Decision trees and random forests",
        "Train/test split and model evaluation"
      ],
      "resources": [
        {
          "label": "GeeksforGeeks Machine Learning",
          "url": "https://www.geeksforgeeks.org/machine-learning/machine-learning-tutorial/"
        }
      ]
    },
    {
      "week": 5,
      "title": "Advanced Machine Learning",
      "goal": "Improve model quality and understand practical ML techniques.",
      "topics": [
        "Support vector machines",
        "Naive Bayes",
        "K-means clustering",
        "Hierarchical clustering and PCA",
        "Feature engineering and feature selection",
        "Cross-validation and hyperparameter tuning",
        "Pipelines and preventing data leakage"
      ],
      "resources": [
        {
          "label": "GeeksforGeeks Machine Learning",
          "url": "https://www.geeksforgeeks.org/machine-learning/machine-learning-tutorial/"
        }
      ]
    },
    {
      "week": 6,
      "title": "Deep Learning",
      "goal": "Understand neural networks and train a basic deep learning model.",
      "topics": [
        "Neurons, layers and activation functions",
        "Forward propagation and backpropagation",
        "Loss functions and optimizers",
        "Gradient descent",
        "Overfitting, dropout and regularization",
        "Introduction to TensorFlow or PyTorch",
        "Build a small neural network"
      ],
      "resources": [
        {
          "label": "GeeksforGeeks Deep Learning",
          "url": "https://www.geeksforgeeks.org/deep-learning/deep-learning-tutorial/"
        }
      ]
    },
    {
      "week": 7,
      "title": "NLP and Computer Vision",
      "goal": "Explore two major applied AI areas.",
      "topics": [
        "Text preprocessing and tokenization",
        "Bag of words and TF-IDF",
        "Word embeddings and transformers overview",
        "Image pixels, channels and preprocessing",
        "Convolutional neural networks",
        "Transfer learning",
        "Small NLP or computer vision experiment"
      ],
      "resources": [
        {
          "label": "GeeksforGeeks NLP",
          "url": "https://www.geeksforgeeks.org/nlp/natural-language-processing-nlp-tutorial/"
        },
        {
          "label": "GeeksforGeeks Computer Vision",
          "url": "https://www.geeksforgeeks.org/computer-vision/computer-vision/"
        }
      ]
    },
    {
      "week": 8,
      "title": "Generative AI and AI Engineering",
      "goal": "Understand LLMs and the engineering workflow around AI applications.",
      "topics": [
        "Generative AI concepts and use cases",
        "LLMs, tokens and context windows",
        "Prompt engineering and structured outputs",
        "Embeddings and vector databases",
        "RAG architecture and document retrieval",
        "APIs, FastAPI and environment variables",
        "Git, GitHub and basic deployment"
      ],
      "resources": [
        {
          "label": "GeeksforGeeks Generative AI",
          "url": "https://www.geeksforgeeks.org/artificial-intelligence/what-is-generative-ai/"
        }
      ]
    },
    {
      "week": 9,
      "title": "Project 1: Customer Churn Prediction",
      "goal": "Build an end-to-end tabular ML project.",
      "topics": [
        "Choose and understand a churn dataset",
        "Clean data and explore patterns",
        "Create features and prepare train/test data",
        "Train baseline classification models",
        "Evaluate precision, recall, F1 and ROC-AUC",
        "Tune the best model",
        "Write README with results and limitations"
      ],
      "resources": []
    },
    {
      "week": 10,
      "title": "Project 2: Image Classification",
      "goal": "Build an image classifier using a CNN or transfer learning.",
      "topics": [
        "Choose a manageable image dataset",
        "Inspect and split images",
        "Resize, normalize and augment images",
        "Build or fine-tune a CNN",
        "Evaluate accuracy and confusion matrix",
        "Test predictions on new images",
        "Document the project and sample outputs"
      ],
      "resources": []
    },
    {
      "week": 11,
      "title": "Project 3: PDF Document Q&A (RAG)",
      "goal": "Create a retrieval-augmented question-answering application.",
      "topics": [
        "Extract text from PDF files",
        "Split text into chunks",
        "Generate embeddings",
        "Store and retrieve relevant chunks",
        "Connect retrieved context to an LLM",
        "Build a simple user interface or API",
        "Test answers and cite source passages"
      ],
      "resources": []
    },
    {
      "week": 12,
      "title": "Deployment, GitHub and Job Preparation",
      "goal": "Package your portfolio and prepare for entry-level AI/ML roles.",
      "topics": [
        "Clean and organize GitHub repositories",
        "Write clear project READMEs",
        "Deploy one project",
        "Create an AI/ML fresher resume",
        "Prepare Python and ML interview questions",
        "Practice explaining projects",
        "Apply for internships and entry-level roles"
      ],
      "resources": []
    }
  ]
}